# PhiloProxy — environment variables
# Copy to .env and edit before running: cp .env.example .env

# ── General ───────────────────────────────────────────────────────────────────
TZ=America/Chicago
PORT=5050

# ── Data directory ────────────────────────────────────────────────────────────
# Absolute path on the host that is bind-mounted into the container as /data.
# The SQLite database (philoproxy.db) and any runtime state live here.
DATA_DIR=/opt/philoproxy/data

# ── Philo streaming ───────────────────────────────────────────────────────────
# Maximum number of simultaneous Philo streams (one Xvfb display per stream).
# Each stream spawns a Chromium browser + FFmpeg process.
MAX_PHILO_STREAMS=3

# ── EPG ───────────────────────────────────────────────────────────────────────
# How often (in hours) to refresh Philo EPG data from the GraphQL API.
EPG_REFRESH_HOURS=6

# ── NVIDIA encoding ───────────────────────────────────────────────────────────
# Preset: p1 (fastest) … p7 (slowest/best quality)
FFMPEG_NVENC_PRESET=p4
# Tune: ll (low-latency), hq (high quality), ull (ultra-low-latency)
FFMPEG_NVENC_TUNE=ll

# ── FFmpeg logging ────────────────────────────────────────────────────────────
# quiet | panic | fatal | error | warning | info | verbose | debug
FFMPEG_LOGLEVEL=warning

# ── GHCR image repository (used by docker-compose image: line) ───────────────
# Format: <github-user>/<repo>  (no ghcr.io prefix, no tag)
GHCR_REPO=youruser/philoproxy
